[Unit]
Description=Amalgamating Schnozzle collaboration relay
After=network.target

[Service]
Type=simple
User=schnozzle
Group=schnozzle
WorkingDirectory=/opt/schnozzle
EnvironmentFile=/etc/schnozzle/relay.env
Environment=SCHNOZZLE_DATA=/var/lib/schnozzle
ExecStart=/usr/bin/node --max-old-space-size=128 /opt/schnozzle/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=schnozzle
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=256M
TasksMax=32
LimitNOFILE=256
CPUQuota=50%

[Install]
WantedBy=multi-user.target
